rules_version = '2';

// Receipts are evidence: uploaded once by the submitter, never modified or
// deleted by clients. Reports and exports are only reachable through
// short-lived signed URLs generated by Cloud Functions.
service firebase.storage {
  match /b/{bucket}/o {
    function memberDoc(wid) { return /databases/(default)/documents/workspaces/$(wid)/members/$(request.auth.uid); }
    function isMember(wid) { return request.auth != null && firestore.exists(memberDoc(wid)) && firestore.get(memberDoc(wid)).data.active == true; }
    function role(wid) { return firestore.get(memberDoc(wid)).data.role; }

    match /receipts/{wid}/{uid}/{file} {
      allow create: if resource == null && request.auth != null && request.auth.uid == uid && isMember(wid)
        && role(wid) != 'auditor'
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|heic|heif|webp)|application/pdf');
      allow read: if isMember(wid) && (request.auth.uid == uid || role(wid) in ['owner', 'finance_manager', 'approver', 'auditor']);
      allow update, delete: if false;
    }

    match /logos/{wid}/{file} {
      allow read: if isMember(wid);
      allow write: if isMember(wid) && role(wid) == 'owner'
        && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg)');
    }

    match /{all=**} { allow read, write: if false; }
  }
}
