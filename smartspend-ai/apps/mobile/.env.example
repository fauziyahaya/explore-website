# ── SmartSpend AI mobile app — PUBLIC client configuration ──
# These identify your Firebase project and OAuth clients. They are not secrets
# (access is enforced by Firebase Auth, Security Rules and Cloud Functions).
# Never put API keys for Gemini/Vision, OAuth client secrets or service accounts here.
# Leave all blank to run the app in sample-data demo mode.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Google OAuth: Web client (used for server auth code exchange) and iOS client
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-yyyy.apps.googleusercontent.com
EXPO_PUBLIC_PRIVACY_URL=https://your-domain.my/privacy
EXPO_PUBLIC_TERMS_URL=https://your-domain.my/terms
# Build-time (app.config.ts)
IOS_BUNDLE_ID=my.smartspend.ai
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.1234567890-yyyy
EAS_PROJECT_ID=
